screen.LIGHTING=Lighting
screen.LIGHTING.comment=Light levels and colours. These are placeholder controls until the full lighting model (milestone M1).
screen.CAMERA=Camera
screen.CAMERA.comment=Exposure and image settings.
screen.DEBUG=Debug
screen.DEBUG.comment=Development views. Leave off for normal play.

option.TM_EXPOSURE=Brightness
option.TM_EXPOSURE.comment=Overall image brightness (tonemap exposure).
option.AMBIENT_MULT=Shadow Light
option.AMBIENT_MULT.comment=Amount of sky light in shaded areas.
option.CAVE_LIGHTING=Cave Lighting
option.CAVE_LIGHTING.comment=Minimum light in places without sky or block light.
option.BLOCKLIGHT_I=Blocklight Intensity
option.BLOCKLIGHT_I.comment=Brightness of torches, lanterns and other light sources.
option.BLOCKLIGHT_R=Blocklight Red
option.BLOCKLIGHT_G=Blocklight Green
option.BLOCKLIGHT_B=Blocklight Blue
option.VANILLA_AO_I=Vanilla AO
option.VANILLA_AO_I.comment=Strength of Minecraft's own corner shading (smooth lighting).
option.BORDER_FOG=Border Fog
option.BORDER_FOG.comment=Fades out the edge of the loaded world to hide chunk borders.

option.DEBUG_VIEW=Debug View
option.DEBUG_VIEW.comment=Shows one G-buffer channel instead of the final image.
value.DEBUG_VIEW.0=Off
value.DEBUG_VIEW.1=Albedo
value.DEBUG_VIEW.2=Normals
value.DEBUG_VIEW.3=Lightmap
value.DEBUG_VIEW.4=Shading Model
value.DEBUG_VIEW.5=Vanilla AO
value.DEBUG_VIEW.6=Emission

option.TM_CONTRAST=Contrast
option.TM_CONTRAST.comment=Darkens darks and brightens brights.
option.TM_WHITE_PATH=White Reachability
option.TM_WHITE_PATH.comment=How bright something must be to reach pure white. Lower values make bright areas clip to white sooner.
option.T_SATURATION=Saturation
option.T_SATURATION.comment=Overall colourfulness of the image.
option.DEBUG_PARTICLES=Debug Particles
option.DEBUG_PARTICLES.comment=Draws all particles flat magenta. Used to diagnose missing particles.
value.DEBUG_PARTICLES.0=Off
value.DEBUG_PARTICLES.1=On

screen.SHADOWS=Shadows
screen.SHADOWS.comment=Sun and moon shadows. Shadow Distance has the biggest performance impact (it re-renders the world from the sun).
option.shadowMapResolution=Shadow Resolution
option.shadowMapResolution.comment=Sharpness of shadows. 4096 is a good balance; 8192 costs noticeably more VRAM and fill rate.
option.shadowDistance=§eShadow Distance§r
option.shadowDistance.comment=How far from you shadows are drawn. Higher values re-render more of the world from the sun's view (CPU and GPU cost).
value.shadowDistance.64.0=4 Chunks
value.shadowDistance.96.0=6 Chunks
value.shadowDistance.128.0=8 Chunks
value.shadowDistance.160.0=10 Chunks
value.shadowDistance.192.0=12 Chunks
value.shadowDistance.224.0=14 Chunks
value.shadowDistance.256.0=16 Chunks
value.shadowDistance.320.0=20 Chunks
value.shadowDistance.384.0=24 Chunks
value.shadowDistance.512.0=32 Chunks
option.SHADOW_SOFTNESS=Shadow Softness
option.SHADOW_SOFTNESS.comment=Width of the shadow edge blur.
option.ENTITY_SHADOWS=§eEntity Shadows§r
option.ENTITY_SHADOWS.comment=Mobs and players cast shadows (within a quarter of the shadow distance). Block entities like chests never do, for performance.
option.COLORED_SHADOWS=Coloured Shadows
option.COLORED_SHADOWS.comment=Light through stained glass is tinted instead of blocked.
option.FOLIAGE_SSS=Leaf Translucency
option.FOLIAGE_SSS.comment=Sunlight passing through leaves and grass, strongest when looking towards the sun.

screen.ATMOSPHERE=Atmosphere
screen.ATMOSPHERE.comment=Sky, sun, moon, stars and fog.
option.SUN_MOON_STYLE=Sun/Moon Style
option.SUN_MOON_STYLE.comment=Unbound: the shader draws a bright sun and a moon with real phases. Vanilla: the resource pack's sun and moon textures.
value.SUN_MOON_STYLE.1=Unbound
value.SUN_MOON_STYLE.2=Vanilla
option.SUN_MOON_HORIZON=Sun/Moon Horizon
option.SUN_MOON_HORIZON.comment=Hides the sun and moon below the horizon.
option.SUN_MOON_DURING_RAIN=Sun/Moon During Rain
option.SUN_MOON_DURING_RAIN.comment=Keeps the sun and moon visible through rain clouds.
option.STAR_AMOUNT=Star Amount
value.STAR_AMOUNT.0=Off
value.STAR_AMOUNT.1=Low
value.STAR_AMOUNT.2=Medium
value.STAR_AMOUNT.3=High
value.STAR_AMOUNT.4=Very High
option.MOON_PHASE_LIGHTING=Moon Phase Lighting
option.MOON_PHASE_LIGHTING.comment=Nights are brighter at full moon and darker at new moon.
option.END_STAR_INTENSITY=End Star Brightness
option.ATM_FOG_MULT=Atmospheric Fog
option.ATM_FOG_MULT.comment=Strength of the distance haze. It is thickest near the fog altitude and thins out higher up.
option.ATM_FOG_DISTANCE=Atmospheric Fog Distance
option.ATM_FOG_DISTANCE.comment=Higher values push the haze further away. Also scales with your render distance.
option.ATM_FOG_ALTITUDE=Atmospheric Fog Altitude
option.ATM_FOG_ALTITUDE.comment=World height where the haze is densest.
option.CAVE_FOG=Cave Fog
option.CAVE_FOG.comment=Dark fog while underground.
option.LESS_LAVA_FOG=Less Lava/Snow Fog
option.LESS_LAVA_FOG.comment=See further while inside lava or powder snow.
option.NETHER_VIEW_LIMIT=Nether View Limit
option.NETHER_VIEW_LIMIT.comment=How far you can see in the Nether before the fog closes in.
value.NETHER_VIEW_LIMIT.99999.0=Limitless

screen.WATER=Water
screen.WATER.comment=Water appearance.
option.WATER_REFLECTIONS=§eWater Reflections§r
option.WATER_REFLECTIONS.comment=Reflects the world on water (screen-space). Off: sky only.
value.WATER_REFLECTIONS.0=Sky Only
value.WATER_REFLECTIONS.1=Screen-Space
option.WATER_FOG_MULT=Water Murkiness
option.WATER_FOG_MULT.comment=How quickly water becomes opaque with depth.
option.WATER_WAVE_STRENGTH=Wave Strength
option.WATER_WAVE_SPEED=Wave Speed
option.WATER_WAVE_SIZE=Wave Size
